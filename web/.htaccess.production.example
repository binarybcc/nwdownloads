# Circulation Dashboard - Environment Configuration (TEMPLATE)
# Native Synology MariaDB10 Connection
#
# Copy to .htaccess.production and fill in the real values. The real file is
# gitignored — credentials must never be committed. Apache SetEnv cannot read
# an external file, so this one config keeps literal values on the server.

# Set environment variables for PHP
SetEnv DB_HOST localhost
SetEnv DB_PORT 3307
SetEnv DB_NAME circulation_dashboard
SetEnv DB_USER CHANGE_ME
SetEnv DB_PASSWORD CHANGE_ME
SetEnv DB_SOCKET /run/mysqld/mysqld10.sock

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Disable directory browsing
Options -Indexes

# Protect sensitive files (Apache 2.4 syntax)
<FilesMatch "\.(env|log|sql|md)$">
    Require all denied
</FilesMatch>
